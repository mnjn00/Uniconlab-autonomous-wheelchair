# Catkin/ROS build outputs
build/
devel/
install/
log/
logs/
.catkin_tools/

# Python/test caches
__pycache__/
*.py[cod]
.pytest_cache/
.gjc/

# ROS/Gazebo runtime
.ros/
*.bag
*.db3
*.mcap
*.active

# ... except curated field evidence, which is the opposite of a runtime
# artifact: a recording nobody can make again. Kept in Git LFS so the repo
# and every NUC deployment that pulls it stay small, and checksummed in
# blackbox/manifest.json so a copy on any disk can be verified against what
# the vehicle actually wrote.
!blackbox/*.bag
*.log

# Large local generated artifacts
artifacts/

# Editor/OS
.vscode/
.idea/
.DS_Store

# Agent/tool session state
.omc/
.omo/
.claude/

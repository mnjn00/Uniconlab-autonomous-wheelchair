<?xml version="1.0"?>
<!--
  HARDWARE ONLY. Do not use this file to spawn the Gazebo wheelchair.

  Copied from the active NUC model at
  /home/mprp3/catkin_ws/src/base_model/urdf/wheel.xacro
  (source SHA-256 103608f9b9eadeabf685c0bde76a02240c9fb8d6e85c25cb382fcfaa8fb899ec),
  then corrected to use REP-103 frame names and the measured 2026-07-27
  left-armrest Livox/IMU offset.

  Frame contract:
    base_footprint  drive-wheel axle midpoint projected onto the ground
    base_link       legacy NUC chassis origin, 0.260 m forward of the axle
    imu_link/body   FAST-LIO built-in IMU body origin
    lidar_link      Livox optical origin

  The horizontal body offset was fitted from six physical in-place rotations.
  Re-measure it whenever the sensor mount moves. The remaining legacy chassis
  dimensions are copied, not newly certified physical measurements.
-->
<robot name="wheelchair_hardware" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="frame_black"><color rgba="0.02 0.02 0.02 1.0"/></material>
  <material name="wheel_blue"><color rgba="0.20 0.24 0.29 1.0"/></material>
  <material name="support_green"><color rgba="0.0 0.8 0.0 1.0"/></material>
  <material name="lidar_green"><color rgba="0.0 0.45 0.20 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.260 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual name="chassis_visual">
      <origin xyz="0 0 0.300" rpy="0 0 0"/>
      <geometry><box size="0.520 0.400 0.050"/></geometry>
      <material name="frame_black"/>
    </visual>
    <collision name="chassis_collision">
      <origin xyz="0 0 0.300" rpy="0 0 0"/>
      <geometry><box size="0.520 0.400 0.050"/></geometry>
    </collision>
  </link>

  <link name="link_back_frame">
    <visual name="back_frame_visual">
      <origin xyz="0 0 0" rpy="0 1.5707 0"/>
      <geometry><box size="0.460 0.400 0.050"/></geometry>
      <material name="frame_black"/>
    </visual>
    <collision name="back_frame_collision">
      <origin xyz="0 0 0" rpy="0 1.5707 0"/>
      <geometry><box size="0.460 0.400 0.050"/></geometry>
    </collision>
  </link>

  <joint name="joint_back_frame" type="fixed">
    <parent link="base_link"/>
    <child link="link_back_frame"/>
    <origin xyz="-0.2625 0 0.555" rpy="0 0 0"/>
  </joint>

  <link name="link_left_wheel">
    <visual name="left_wheel_visual">
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry><cylinder length="0.040" radius="0.300"/></geometry>
      <material name="wheel_blue"/>
    </visual>
    <collision name="left_wheel_collision">
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry><cylinder length="0.040" radius="0.300"/></geometry>
    </collision>
  </link>

  <joint name="joint_left_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="link_left_wheel"/>
    <origin xyz="-0.260 0.220 0.300" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10000" velocity="1000"/>
    <joint_properties damping="1.0" friction="1.0"/>
  </joint>

  <link name="link_right_wheel">
    <visual name="right_wheel_visual">
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry><cylinder length="0.040" radius="0.300"/></geometry>
      <material name="wheel_blue"/>
    </visual>
    <collision name="right_wheel_collision">
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry><cylinder length="0.040" radius="0.300"/></geometry>
    </collision>
  </link>

  <joint name="joint_right_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="link_right_wheel"/>
    <origin xyz="-0.260 -0.220 0.300" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10000" velocity="1000"/>
    <joint_properties damping="1.0" friction="1.0"/>
  </joint>

  <link name="link_support_left_bar">
    <visual name="support_left_bar_visual">
      <origin xyz="0 0 0" rpy="0 -1.5707 0"/>
      <geometry><box size="0.160 0.040 0.040"/></geometry>
      <material name="support_green"/>
    </visual>
    <collision name="support_left_bar_collision">
      <origin xyz="0 0 0" rpy="0 -1.5707 0"/>
      <geometry><box size="0.160 0.040 0.040"/></geometry>
    </collision>
  </link>

  <joint name="joint_support_left_bar" type="fixed">
    <parent link="base_link"/>
    <child link="link_support_left_bar"/>
    <origin xyz="0.242 0.180 0.195" rpy="0 0 0"/>
  </joint>

  <link name="link_support_right_bar">
    <visual name="support_right_bar_visual">
      <origin xyz="0 0 0" rpy="0 -1.5707 0"/>
      <geometry><box size="0.160 0.040 0.040"/></geometry>
      <material name="support_green"/>
    </visual>
    <collision name="support_right_bar_collision">
      <origin xyz="0 0 0" rpy="0 -1.5707 0"/>
      <geometry><box size="0.160 0.040 0.040"/></geometry>
    </collision>
  </link>

  <joint name="joint_support_right_bar" type="fixed">
    <parent link="base_link"/>
    <child link="link_support_right_bar"/>
    <origin xyz="0.242 -0.180 0.195" rpy="0 0 0"/>
  </joint>

  <link name="link_support_left_wheel">
    <visual name="support_left_wheel_visual">
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry><cylinder length="0.040" radius="0.070"/></geometry>
      <material name="wheel_blue"/>
    </visual>
    <collision name="support_left_wheel_collision">
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry><cylinder length="0.040" radius="0.070"/></geometry>
    </collision>
  </link>

  <joint name="joint_support_left_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="link_support_left_wheel"/>
    <origin xyz="0.242 0.220 0.070" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10000" velocity="1000"/>
    <joint_properties damping="1.0" friction="1.0"/>
  </joint>

  <link name="link_support_right_wheel">
    <visual name="support_right_wheel_visual">
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry><cylinder length="0.040" radius="0.070"/></geometry>
      <material name="wheel_blue"/>
    </visual>
    <collision name="support_right_wheel_collision">
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry><cylinder length="0.040" radius="0.070"/></geometry>
    </collision>
  </link>

  <joint name="joint_support_right_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="link_support_right_wheel"/>
    <origin xyz="0.242 -0.220 0.070" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10000" velocity="1000"/>
    <joint_properties damping="1.0" friction="1.0"/>
  </joint>

  <link name="lidar_link">
    <visual name="livox_visual">
      <geometry><cylinder radius="0.045" length="0.070"/></geometry>
      <material name="lidar_green"/>
    </visual>
    <collision name="livox_collision">
      <geometry><cylinder radius="0.045" length="0.070"/></geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.246 0.14971 0.300" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.257 0.173 0.25588" rpy="0 0 0"/>
  </joint>

  <link name="body"/>

  <joint name="fast_lio_body_joint" type="fixed">
    <parent link="imu_link"/>
    <child link="body"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>

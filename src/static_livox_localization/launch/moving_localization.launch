<launch>
  <arg name="config" default="$(find static_livox_localization)/config/moving_localization.yaml"/>
  <arg name="visualization" default="true"/>
  <arg name="rviz" default="false"/>
  <arg name="auto_init" default="false"/>
  <arg name="auto_init_global_only" default="false"/>
  <arg name="registration_backend" default="pcl_gicp"/>
  <arg name="map_path" default="/home/mprp3/wheelchair_localization_maps/merged_0707_0725_v1/merged_0707_0725_0p20m_xyzi.pcd"/>
  <arg name="map_sha256" default="ee317581328d3eaeee86ba448b0068c1016ca1452664b6cdaba2d874320d0431"/>
  <arg name="map_id" default="merged_0707_0725_v1"/>
  <arg name="auto_init_map" default="$(arg map_path)"/>
  <arg name="auto_init_traj" default="/home/mprp3/wheelchair_localization_maps/merged_0707_0725_v1/traj_lidar.txt"/>
  <arg name="auto_init_route" default="/home/mprp3/wheelchair_localization_src/routes/20260812_route_v6_v8_waypoints.json"/>
  <arg name="auto_init_body_frame_profile" default="builtin"/>
  <!-- How much of what the chair can see a global fix must explain before
       it is believed. The default is derived from synthetic scenes;
       transient structure the map does not hold lowers a correct fix, so
       this is exposed for calibration on the route, not buried in the node. -->
  <arg name="auto_init_min_refined_score" default="0.78"/>
  <arg name="auto_init_require_gpu" default="false"/>
  <arg name="auto_init_gpu_lateral_radius_m" default="10.0"/>
  <arg name="auto_init_gpu_lateral_step_m" default="1.0"/>

  <node pkg="static_livox_localization"
        type="moving_icp_localizer"
        name="moving_icp_localizer"
        output="screen"
        required="true">
    <rosparam command="load" file="$(arg config)"/>
    <param name="registration_backend" value="$(arg registration_backend)"/>
    <param name="map_path" value="$(arg map_path)"/>
    <param name="map_sha256" value="$(arg map_sha256)"/>
    <param name="map_id" value="$(arg map_id)"/>
  </node>

  <group if="$(arg visualization)">
    <node pkg="static_livox_localization"
          type="bounded_cloud_preview_node"
          name="bounded_cloud_preview"
          output="screen">
      <rosparam command="load" file="$(arg config)"/>
      <param name="map_path" value="$(arg map_path)"/>
      <param name="map_sha256" value="$(arg map_sha256)"/>
      <param name="map_id" value="$(arg map_id)"/>
    </node>

    <node pkg="static_livox_localization"
          type="map_preview_publisher"
          name="map_preview_publisher"
          output="screen">
      <rosparam command="load" file="$(arg config)"/>
      <param name="map_path" value="$(arg map_path)"/>
      <param name="map_sha256" value="$(arg map_sha256)"/>
      <param name="map_id" value="$(arg map_id)"/>
    </node>
    <node pkg="static_livox_localization"
          type="reference_marker.py"
          name="reference_marker"
          output="screen"/>
    <node pkg="static_livox_localization"
          type="localization_state_marker.py"
          name="localization_state_marker"
          output="screen"/>
  </group>

  <node if="$(arg rviz)"
        pkg="rviz"
        type="rviz"
        name="moving_localization_rviz"
        args="-d $(find static_livox_localization)/config/moving_localization.rviz"
        output="screen"/>

  <node if="$(arg auto_init)"
        pkg="static_livox_localization"
        type="auto_initial_pose.py"
        name="auto_initial_pose"
        output="screen">
    <param name="map" value="$(arg auto_init_map)"/>
    <param name="traj" value="$(arg auto_init_traj)"/>
    <param name="route" value="$(arg auto_init_route)"/>
    <param name="body_frame_profile" value="$(arg auto_init_body_frame_profile)"/>
    <param name="min_refined_score" value="$(arg auto_init_min_refined_score)"/>
    <param name="global_only" value="$(arg auto_init_global_only)"/>
    <param name="require_gpu" value="$(arg auto_init_require_gpu)"/>
    <param name="gpu_lateral_radius_m" value="$(arg auto_init_gpu_lateral_radius_m)"/>
    <param name="gpu_lateral_step_m" value="$(arg auto_init_gpu_lateral_step_m)"/>
  </node>
</launch>


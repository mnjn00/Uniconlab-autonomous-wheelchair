<launch>
<!-- FAST-LIO on the MID360 lidar + VectorNav VN-100 IMU.

     Deployed by tools/deploy_fastlio_vn100.sh, which copies this file
     and its config into fast_lio_ws/src/FAST_LIO/ under the SAME
     names - FAST-LIO resolves both from its own package path. mapping_mid360.launch (the
     built-in IMU version) stays in place as the rollback: swapping the
     launch name in start_wheelchair_localization.sh reverts the chair to
     the previously validated configuration.

     Every param below matches mapping_mid360.launch; only the loaded
     config file differs. -->

	<arg name="rviz" default="true" />

	<rosparam command="load" file="$(find fast_lio)/config/fastlio_mid360_vn100.yaml" />

	<param name="feature_extract_enable" type="bool" value="0"/>
	<param name="point_filter_num" type="int" value="3"/>
	<param name="max_iteration" type="int" value="3" />
	<param name="filter_size_surf" type="double" value="0.5" />
	<param name="filter_size_map" type="double" value="0.5" />
	<param name="cube_side_length" type="double" value="1000" />
	<param name="runtime_pos_log_enable" type="bool" value="0" />
    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" />

	<group if="$(arg rviz)">
	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" />
	</group>

</launch>
